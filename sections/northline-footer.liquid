{% comment %}
  Section: Northline Footer for Sunset Surf Apparel
  Clean 4-column categorization: Shop, Collections, Support, Company + Social Links and Copyright.
{% endcomment %}

<footer class="nl-footer" id="NorthlineFooter">
  <div class="nl-footer-inner">
    <div class="nl-footer-main">
      <div class="nl-footer-brand-col">
        <h2 class="nl-footer-brand font-display">
          {{ section.settings.brand_name | default: 'SUNSET SURF' }}
        </h2>
        <p class="nl-footer-tagline font-sans">
          {{ section.settings.tagline | default: 'Coastal essentials designed with a focused uniform mindset for everyday adventure.' }}
        </p>

        <div class="nl-footer-socials">
          <a href="https://instagram.com" target="_blank" rel="noopener" class="nl-footer-social-link" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener" class="nl-footer-social-link" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <a href="https://tiktok.com" target="_blank" rel="noopener" class="nl-footer-social-link" aria-label="TikTok">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
          </a>
          <a href="https://pinterest.com" target="_blank" rel="noopener" class="nl-footer-social-link" aria-label="Pinterest">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="12" y1="4" x2="12" y2="20"></line><path d="M8 8a5 5 0 0 1 8 0c0 4-3 6-4 9"></path></svg>
          </a>
        </div>
      </div>

      <div class="nl-footer-nav-grid">
        <!-- 1. Shop Column -->
        <div class="nl-footer-col">
          <h3 class="nl-footer-col-title font-display">Shop</h3>
          <ul class="nl-footer-col-list font-sans">
            <li><a href="{{ routes.all_products_collection_url }}">All Products</a></li>
            <li><a href="/collections/all">New Arrivals</a></li>
            <li><a href="#bestsellers">Best Sellers</a></li>
            <li><a href="/collections">Collections</a></li>
          </ul>
        </div>

        <!-- 2. Support Column -->
        <div class="nl-footer-col">
          <h3 class="nl-footer-col-title font-display">Support</h3>
          <ul class="nl-footer-col-list font-sans">
            <li><a href="/pages/contact">Contact Us</a></li>
            <li><a href="/pages/contact">FAQs</a></li>
            <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
            <li><a href="/policies/refund-policy">Returns & Refunds</a></li>
            <li><a href="/pages/contact">Track Order</a></li>
          </ul>
        </div>

        <!-- 3. Company Column -->
        <div class="nl-footer-col">
          <h3 class="nl-footer-col-title font-display">Company</h3>
          <ul class="nl-footer-col-list font-sans">
            <li><a href="/pages/about">About Us</a></li>
            <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
            <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          </ul>
        </div>

        <!-- 4. Social Column -->
        <div class="nl-footer-col">
          <h3 class="nl-footer-col-title font-display">Social</h3>
          <ul class="nl-footer-col-list font-sans">
            <li><a href="https://instagram.com" target="_blank" rel="noopener">Instagram</a></li>
            <li><a href="https://facebook.com" target="_blank" rel="noopener">Facebook</a></li>
            <li><a href="https://tiktok.com" target="_blank" rel="noopener">TikTok</a></li>
            <li><a href="https://pinterest.com" target="_blank" rel="noopener">Pinterest</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="nl-footer-bottom">
      <p class="nl-footer-bottom-note font-sans">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Sunset Surf Apparel' }}. All rights reserved.
      </p>
      <p class="nl-footer-bottom-note font-sans">
        Checkout powered by Shopify
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Northline Footer",
  "tag": "section",
  "class": "northline-footer-section",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "SUNSET SURF"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Coastal essentials designed with a focused uniform mindset for everyday adventure."
    }
  ],
  "presets": [
    {
      "name": "Northline Footer"
    }
  ]
}
{% endschema %}
