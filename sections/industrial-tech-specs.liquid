{% comment %}
  Section: Industrial Tech Specs & Craftsmanship
  Highlights raw materials, fabrication, and coastal engineering.
{% endcomment %}

<div class="lux-specs" id="IndustrialSpecs-{{ section.id }}">
  <div class="lux-specs__grid">
    <div class="lux-spec-card">
      <p class="lux-spec-card__code">SPEC.01 // FABRIC</p>
      <h3 class="lux-spec-card__title">480 GSM Heavy French Terry</h3>
      <p class="lux-spec-card__text">Ultra-dense custom loopback fleece engineered for coastal sea breezes, structural drape, and lifelong durability.</p>
    </div>

    <div class="lux-spec-card">
      <p class="lux-spec-card__code">SPEC.02 // STITCH</p>
      <h3 class="lux-spec-card__title">Precision Multi-Needle Craft</h3>
      <p class="lux-spec-card__text">High-density artisanal embroidery featuring our signature manta ray, sea turtle, and floral heritage motifs.</p>
    </div>

    <div class="lux-spec-card">
      <p class="lux-spec-card__code">SPEC.03 // PIGMENT</p>
      <h3 class="lux-spec-card__title">Sun-Fade Botanical Wash</h3>
      <p class="lux-spec-card__text">Individual garment dye treatments delivering unique vintage fading, soft hand feel, and zero pre-shrinkage.</p>
    </div>

    <div class="lux-spec-card">
      <p class="lux-spec-card__code">SPEC.04 // ETHOS</p>
      <h3 class="lux-spec-card__title">100% Organic & Ocean Backed</h3>
      <p class="lux-spec-card__text">Regenerative organic cotton supporting the Sunset Foundation for marine conservation and coastline restoration.</p>
    </div>
  </div>
</div>

