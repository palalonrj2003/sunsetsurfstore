{% comment %}
  Section: Northline Featured Collections (Max 3)
  Clean Northline editorial cards with real Sunset Surf imagery.
{% endcomment %}

<section class="nl-feat-collections-section" id="collections">
  <div class="nl-container">
    <div class="nl-collection-header" style="margin-bottom: 32px; border-bottom: none; padding-bottom: 0;">
      <div>
        <p class="nl-collection-subtitle">
          {{ section.settings.eyebrow | default: 'Featured Collections' }}
        </p>
        <h2 class="nl-collection-title font-display">
          {{ section.settings.title | default: 'Featured Collections' }}
        </h2>
      </div>
      <p class="nl-collection-count font-sans">
        03 SERIES
      </p>
    </div>

    <div class="nl-feat-collections-grid">
      {% for block in section.blocks %}
        {%- liquid
          assign col = block.settings.collection
          assign col_image = block.settings.image
          if col_image == blank
            if forloop.index == 1
              assign default_col_img = 'https://cdn.shopify.com/s/files/1/0711/4696/3195/files/SunsetSurf-127.jpg?v=1789758542'
            elsif forloop.index == 2
              assign default_col_img = 'https://cdn.shopify.com/s/files/1/0711/4696/3195/files/SunsetSurf-37.jpg?v=1789752374'
            else
              assign default_col_img = 'https://cdn.shopify.com/s/files/1/0711/4696/3195/files/SunsetSurf-99.jpg?v=1789668755'
            endif
          endif
        -%}
        <a href="{{ col.url | default: block.settings.custom_link | default: '/collections/all' }}" class="nl-feat-col-card" {{ block.shopify_attributes }}>
          <div class="nl-feat-col-image-wrapper">
            {% if col_image != blank %}
              {{ col_image | image_url: width: 1200 | image_tag: class: 'nl-feat-col-image', loading: 'lazy', widths: '400, 700, 1000, 1200', alt: block.settings.title }}
            {% elsif col.image != blank %}
              {{ col.image | image_url: width: 1200 | image_tag: class: 'nl-feat-col-image', loading: 'lazy', widths: '400, 700, 1000, 1200', alt: col.title }}
            {% else %}
              <img src="{{ default_col_img }}" class="nl-feat-col-image" alt="{{ block.settings.title }}" loading="lazy" width="600" height="800">
            {% endif %}
            <div class="nl-feat-col-overlay"></div>
          </div>
          <div class="nl-feat-col-content">
            <h3 class="nl-feat-col-title font-display">{{ block.settings.title | default: col.title | default: 'Collection' }}</h3>
            {% if block.settings.subtitle != blank %}
              <p class="nl-feat-col-sub font-sans">{{ block.settings.subtitle }}</p>
            {% elsif col.products_count > 0 %}
              <p class="nl-feat-col-sub font-sans">{{ col.products_count }} items</p>
            {% endif %}
            <span class="nl-feat-col-link font-sans">
              <span>Explore Series</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </div>
        </a>
      {% endfor %}
    </div>

    {% if section.settings.btn_text != blank %}
      <div class="nl-feat-collections-footer">
        <a href="{{ section.settings.btn_link | default: '/collections' }}" class="nl-btn-editorial font-sans">
          <span>{{ section.settings.btn_text }}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
  "class": "section-northline-featured-collections",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Curated Series"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Collections"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "View All Collections →"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection (Max 3)",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Shopify Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Cover Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title Override (e.g. Outerwear)",
          "default": "Outerwear"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Sub-label",
          "default": "Hoodies & Jackets"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom URL (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        {
          "type": "collection_item",
          "settings": {
            "title": "Outerwear",
            "subtitle": "Hoodies & Jackets"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "title": "Bottoms",
            "subtitle": "Shorts & Pants"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "title": "Accessories",
            "subtitle": "Caps, Bags & Gear"
          }
        }
      ]
    }
  ]
}
{% endschema %}
