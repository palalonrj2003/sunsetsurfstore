{% doc %}
  Section contract: northline-why-choose-us.liquid
  Renders 4 trust signal columns with minimalist industrial aesthetics.
{% enddoc %}

<section class="nl-trust-section" id="trust">
  <div class="nl-trust-grid">
      <div class="nl-trust-item">
        <div class="nl-trust-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="nl-trust-content">
          <h4 class="nl-trust-title font-display">{{ section.settings.col1_title }}</h4>
          <p class="nl-trust-text">{{ section.settings.col1_desc }}</p>
        </div>
      </div>

      <div class="nl-trust-item">
        <div class="nl-trust-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <div class="nl-trust-content">
          <h4 class="nl-trust-title font-display">{{ section.settings.col2_title }}</h4>
          <p class="nl-trust-text">{{ section.settings.col2_desc }}</p>
        </div>
      </div>

      <div class="nl-trust-item">
        <div class="nl-trust-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
        </div>
        <div class="nl-trust-content">
          <h4 class="nl-trust-title font-display">{{ section.settings.col3_title }}</h4>
          <p class="nl-trust-text">{{ section.settings.col3_desc }}</p>
        </div>
      </div>

      <div class="nl-trust-item">
        <div class="nl-trust-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
        <div class="nl-trust-content">
          <h4 class="nl-trust-title font-display">{{ section.settings.col4_title }}</h4>
          <p class="nl-trust-text">{{ section.settings.col4_desc }}</p>
        </div>
      </div>
    </div>
</section>

{% schema %}
{
  "name": "Why Choose Us",
  "tag": "section",
  "class": "section-northline-why-choose-us",
  "settings": [
    {
      "type": "header",
      "content": "Column 1: Shipping"
    },
    {
      "type": "text",
      "id": "col1_title",
      "label": "Title",
      "default": "Fast Shipping"
    },
    {
      "type": "text",
      "id": "col1_desc",
      "label": "Description",
      "default": "Dispatched within 24-48 hours globally."
    },
    {
      "type": "header",
      "content": "Column 2: Security"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Title",
      "default": "Secure Checkout"
    },
    {
      "type": "text",
      "id": "col2_desc",
      "label": "Description",
      "default": "256-bit SSL encrypted payment processing."
    },
    {
      "type": "header",
      "content": "Column 3: Returns"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Title",
      "default": "Easy Returns"
    },
    {
      "type": "text",
      "id": "col3_desc",
      "label": "Description",
      "default": "30-day hassle-free exchange & return policy."
    },
    {
      "type": "header",
      "content": "Column 4: Quality"
    },
    {
      "type": "text",
      "id": "col4_title",
      "label": "Title",
      "default": "Premium Quality"
    },
    {
      "type": "text",
      "id": "col4_desc",
      "label": "Description",
      "default": "Heavyweight fabrics built for everyday durability."
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us"
    }
  ]
}
{% endschema %}
