{% comment %}
  Section: Industrial-Luxury Hero
  Architectural layout with technical metadata and summer coastal cinematography.
{% endcomment %}

<div class="editorial-hero" id="EditorialHero-{{ section.id }}">
  <div class="editorial-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2800
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000, 2800',
          alt: section.settings.title
      }}
    {%- else -%}
      <img
        src="https://images.unsplash.com/photo-1502680390469-be75c86b636f?auto=format&fit=crop&w=2400&q=80"
        alt="Sunset Surf Golden Hour"
        loading="eager"
        fetchpriority="high"
        width="2400"
        height="1400"
      >
    {%- endif -%}
  </div>

  <div class="editorial-hero__overlay"></div>

  <div class="editorial-hero__content">
    <div class="editorial-hero__badge">
      <span>{{ section.settings.badge | default: 'SS-25 // ARCHIVE DROP 08' }}</span>
      <span style="opacity: 0.5;">•</span>
      <span>SECTOR: PACIFIC COAST</span>
    </div>

    {%- if section.settings.title != blank -%}
      <h1 class="editorial-hero__title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="editorial-hero__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="editorial-hero__cta-group">
      {%- if section.settings.btn_1_text != blank -%}
        <a href="{{ section.settings.btn_1_link | default: '/collections/all' }}" class="editorial-btn lux-btn--primary">
          <span>{{ section.settings.btn_1_text }}</span>
          <span>&rarr;</span>
        </a>
      {%- endif -%}

      {%- if section.settings.btn_2_text != blank -%}
        <a href="{{ section.settings.btn_2_link | default: '/collections/all' }}" class="editorial-btn lux-btn--outline-white">
          <span>{{ section.settings.btn_2_text }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Industrial-Luxury Hero",
  "tag": "section",
  "class": "editorial-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Technical Badge Text",
      "default": "SS-25 // ARCHIVE DROP 08"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ENGINEERED FOR SUMMER HORIZONS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Artisanal 480GSM heavyweight cottons and technical embroidery crafted for dawn surf sessions and infinite golden hours."
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Button 1 Label",
      "default": "Explore Archive"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Button 2 Label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Industrial-Luxury Hero"
    }
  ]
}
{% endschema %}
